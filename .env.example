# Copy this file to .env (in the project root) and fill in your values.

# --- React frontend -> FastAPI backend ---
# Only the backend URL goes here. Never put a Supabase service-role key in a VITE_* variable.
VITE_API_URL=http://localhost:8000/api

# --- AI Interview (xAI / Grok) - used by api/ai-interview.js ---
# Get a key from https://console.x.ai
XAI_API_KEY=xai-your-key-here
# Optional: override the model without editing api/ai-interview.js.
# Check https://docs.x.ai for the current model lineup.
# XAI_MODEL=grok-4-fast-non-reasoning
