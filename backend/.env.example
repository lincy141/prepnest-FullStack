# Backend-only secrets. Copy to backend/.env and fill in. NEVER commit .env.
# Supabase -> Project Settings -> API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# The "service_role" key. Keep it on the server only - never in the React app / any VITE_* variable.
SUPABASE_SERVICE_ROLE_KEY=
# Allowed browser origin(s) for CORS. Comma-separate several (e.g. local + deployed).
FRONTEND_URL=http://localhost:5173
